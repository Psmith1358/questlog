@page
@model QuestLog.Pages.Stats.IndexModel
@{
    ViewData["Title"] = "Stats";
}

<h1>My Stats</h1>
<p class="text-muted">Track your progress and level up.</p>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Level</h5>
                <h2>@Model.Level</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Total XP</h5>
                <h2>@Model.TotalXp XP</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Next Level</h5>
                <h2>@Model.XpNeededForNextLevel XP</h2>
                <p class="mb-0">needed to reach Level @(Model.Level + 1)</p>
            </div>
        </div>
    </div>
</div>

<h4>Progress to Level @(Model.Level + 1)</h4>

<div class="progress" style="height: 25px;">
    <div class="progress-bar"
         role="progressbar"
         style="width: @(Model.XpIntoLevel)%;">
        @Model.XpIntoLevel / 100 XP
    </div>
</div>