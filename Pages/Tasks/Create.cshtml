@page
@model QuestLog.Pages.Tasks.CreateModel

@{
    ViewData["Title"] = "Create Task";
}

<h1>Create Task</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="TaskItem.Title" class="control-label"></label>
                <input asp-for="TaskItem.Title" class="form-control" />
                <span asp-validation-for="TaskItem.Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TaskItem.DueDate" class="control-label">Due Date</label>
                <input asp-for="TaskItem.DueDate" class="form-control" />
                <span asp-validation-for="TaskItem.DueDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TaskItem.Priority" class="control-label"></label>
                <select asp-for="TaskItem.Priority"
                        asp-items="Html.GetEnumSelectList<QuestLog.Models.Priority>()"
                        class="form-control">
                </select>
                <span asp-validation-for="TaskItem.Priority" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TaskItem.CategoryId" class="control-label">Category</label>
                <select asp-for="TaskItem.CategoryId"
                        asp-items="ViewBag.CategoryId"
                        class="form-control">
                </select>
                <span asp-validation-for="TaskItem.CategoryId" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>


