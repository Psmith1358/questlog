@page
@model QuestLog.Pages.Tasks.DeleteModel

@{
    ViewData["Title"] = "Delete Task";
}

<h1>Delete Task</h1>

<h3>Are you sure you want to delete this task?</h3>
<hr />

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">
        @Model.TaskItem.Title
    </dd>

    <dt class="col-sm-2">Due Date</dt>
    <dd class="col-sm-10">
        @Model.TaskItem.DueDate?.ToShortDateString()
    </dd>

    <dt class="col-sm-2">Priority</dt>
    <dd class="col-sm-10">
        @Model.TaskItem.Priority
    </dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">
        @Model.TaskItem.Status
    </dd>

    <dt class="col-sm-2">Category</dt>
    <dd class="col-sm-10">
        @(Model.TaskItem.Category?.Name ?? "Uncategorized")
    </dd>
</dl>

<form method="post">
    <input type="hidden" asp-for="TaskItem.Id" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-page="./Index">Back to List</a>
</form>

