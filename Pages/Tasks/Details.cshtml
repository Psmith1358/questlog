@page
@model QuestLog.Pages.Tasks.DetailsModel

@{
    ViewData["Title"] = "Task Details";
}

<h1>Task Details</h1>
<hr />

<dl class="row">
    <dt class="col-sm-2">
        Title
    </dt>
    <dd class="col-sm-10">
        @Model.TaskItem.Title
    </dd>

    <dt class="col-sm-2">
        Due Date
    </dt>
    <dd class="col-sm-10">
        @Model.TaskItem.DueDate?.ToShortDateString()
    </dd>

    <dt class="col-sm-2">
        Priority
    </dt>
    <dd class="col-sm-10">
        @Model.TaskItem.Priority
    </dd>

    <dt class="col-sm-2">
        Status
    </dt>
    <dd class="col-sm-10">
        @Model.TaskItem.Status
    </dd>

    <dt class="col-sm-2">
        Category
    </dt>
    <dd class="col-sm-10">
        @(Model.TaskItem.Category?.Name ?? "Uncategorized")
    </dd>
</dl>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.TaskItem.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
