@page
@model QuestLog.Pages.Profile.IndexModel
@{
    ViewData["Title"] = "Profile";
}

<h1>My Profile</h1>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            
            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.ProfileUser.Email</dd>

            <dt class="col-sm-4">Level</dt>
            <dd class="col-sm-8">@Model.ProfileUser.Level</dd>

            <dt class="col-sm-4">Total XP</dt>
            <dd class="col-sm-8">@Model.ProfileUser.TotalXp</dd>

            <dt class="col-sm-4">Current Streak</dt>
            <dd class="col-sm-8">@Model.ProfileUser.CurrentStreak</dd>

            <dt class="col-sm-4">Last Completed Task</dt>
            <dd class="col-sm-8">@(Model.ProfileUser.LastCompletedDate?.ToString("yyyy-MM-dd") ?? "-")</dd>
        </dl>
    </div>

    <div class="col-md-6">
        <h3>Quick Stats</h3>
        <p>Tasks: @Model.ProfileUser.Tasks.Count</p>
        <p>Badges: @Model.ProfileUser.UserBadges.Count</p>
    </div>
</div>

<h2>Tasks</h2>
@if (Model.ProfileUser.Tasks.Any())
{
    <ul>
    @foreach (var t in Model.ProfileUser.Tasks)
    {
        <li>@t.Title (@t.Status)</li>
    }
    </ul>
}
else
{
    <p>No tasks yet.</p>
}

<h2>Badges</h2>
@if (Model.ProfileUser.UserBadges.Any())
{
    <ul>
    @foreach (var ub in Model.ProfileUser.UserBadges)
    {
        <li>@ub.Badge?.Name - @ub.Badge?.Description (@ub.EarnedAt.ToLocalTime().ToString("yyyy-MM-dd"))</li>
    }
    </ul>
}
else
{
    <p>No badges earned yet.</p>
}
